{
    "name": "Выгодно",
    "short_name": "Выгодно",
    "description": "Выгодные покупки это легко!",
    "categories": ["finance", "shopping", "utilities"],
    "start_url": "/",
    "id": "/?homescreen=1",
    "display": "standalone",
    "orientation": "portrait",
    "theme_color": "#0088CC",
    "background_color": "#FFFFFF",
    "launch_handler": {
        "client_mode": "auto"
    },
    "icons": [
        {
            "src": "/web-app-manifest-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/web-app-manifest-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        }
    ],
    "screenshots": [
        {
            "src": "/screenshot.jpg",
            "sizes": "1280x720",
            "type": "image/jpg",
            "platform": "wide"
        }
    ]
}
